{
	"name": "lacoustics-amplifiers",
	"version": "1.0.2",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-lacoustics-amplifiers.git"
	},
	"engines": {
		"node": "^26.5.0",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"@traversable/zod": "^0.0.57",
		"axios": "^1.21.0",
		"companion-module-utils": "^0.6.1",
		"es-toolkit": "^1.53.1",
		"p-queue": "^10.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"eslint": "^10.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.0"
}
